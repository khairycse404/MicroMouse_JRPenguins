<launch>

    <let name="urdf_path" 
        value="$(find-pkg-share mouse_description)/urdf/mouse_urdf.xacro"/>

    <let name="bridge_config_path" 
        value="$(find-pkg-share mouse_description)/config/gz_bridge.yaml"/>

    <let name="world_path" 
        value="$(find-pkg-share mouse_description)/worlds/maze_world.sdf"/>



    <set_env name="GZ_SIM_RESOURCE_PATH" value="$(find-pkg-share mouse_description)/.."/>

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="$(var world_path) -r"/>
    </include>

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" 
            value="$(command 'xacro $(var urdf_path)')"/>
        <param name="use_sim_time" value="true"/>
    </node>
    

    <node pkg="ros_gz_bridge" exec="parameter_bridge" name="parameter_bridge">
        <param name="config_file" value="$(var bridge_config_path)" />
    </node>

    <node pkg="ros_gz_sim" exec="create"
          args="-topic robot_description -x 1.4852 -y -1.4514 -z 0.5 -Y 3.14159"
          output="screen"/>


    <!-- <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(find-pkg-share mouse_description)/rviz/rviz_config.rviz"/>  -->

</launch>
