<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ================================================================== -->
    <!-- GAZEBO SIM (IGNITION) PLUGINS FOR MOTION CONTROL (DIFF DRIVE)      -->
    <!-- ================================================================== -->

    <gazebo>
        <!-- The <plugin> tag loads the modern Gazebo Sim DiffDrive system. -->
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">

            <!-- Odometry publication frequency in Hz (Replaces update_rate). -->
            <odom_publish_frequency>50</odom_publish_frequency>

            <!-- ========================================================== -->
            <!-- WHEEL JOINT CONFIGURATION                                  -->
            <!-- ========================================================== -->

            <!-- Left wheels (Physically on the right side in your URDF) -->
            <left_joint>BR_wheel_joint</left_joint>
            <left_joint>FR_wheel_joint</left_joint>

            <!-- Right wheels (Physically on the left side in your URDF) -->
            <right_joint>BL_wheel_joint</right_joint>
            <right_joint>FL_wheel_joint</right_joint>

            <!-- ========================================================== -->
            <!-- KINEMATICS (PHYSICAL DIMENSIONS)                           -->
            <!-- ========================================================== -->

            <!-- Distance between the left and right wheels in meters. -->
            <wheel_separation>0.0555</wheel_separation>

            <!-- Wheel radius in meters (Replaces wheel_diameter). Your diameter is 0.02, so radius is 0.01. -->
            <wheel_radius>0.01</wheel_radius>

            <!-- ========================================================== -->
            <!-- LIMITS (ACCELERATION)                                      -->
            <!-- ========================================================== -->

            <!-- Sets the maximum linear acceleration in m/s^2. -->
            <max_linear_acceleration>2.0</max_linear_acceleration>
            
            <!-- Sets the maximum angular acceleration in rad/s^2. -->
            <max_angular_acceleration>2.0</max_angular_acceleration>

            <!-- ========================================================== -->
            <!-- ROS 2 TOPICS AND ODOMETRY CONFIGURATION                    -->
            <!-- ========================================================== -->

            <!-- Custom topic for receiving velocity commands (cmd_vel). -->
            <topic>/cmd_vel</topic>

            <!-- Custom topic for publishing odometry data. -->
            <odom_topic>/odom</odom_topic>

            <!-- Custom topic for publishing the transform (tf). -->
            <tf_topic>/tf</tf_topic>

            <!-- Custom frame_id used as the origin of the odometry. -->
            <frame_id>odom</frame_id>

            <!-- Custom child_frame_id used as the target of the odometry transform. -->
            <child_frame_id>base_link</child_frame_id>

        </plugin>
    </gazebo>

    <!-- ========================================================== -->
    <!-- TOF SENSORS (SIMULATED AS SINGLE-RAY GPU LIDAR)            -->
    <!-- ========================================================== -->

    <!-- Middle TOF Sensor -->
    <gazebo reference="TOF_Middle_link">
        <sensor name="tof_middle_sensor" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>1</samples> 
                        <resolution>1</resolution>
                        <min_angle>0.0</min_angle>
                        <max_angle>0.0</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.01</min>
                    <max>2.0</max>
                    <resolution>0.001</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.002</stddev> 
                </noise>
            </ray>
            <topic>/tof/middle</topic>
            <gz_frame_id>TOF_Middle_link</gz_frame_id>
        </sensor>
    </gazebo>

    <!-- Right TOF Sensor -->
    <gazebo reference="TOF_Right_link">
        <sensor name="tof_right_sensor" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>1</samples>
                        <resolution>1</resolution>
                        <min_angle>0.0</min_angle>
                        <max_angle>0.0</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.01</min>
                    <max>2.0</max>
                    <resolution>0.001</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.002</stddev>
                </noise>
            </ray>
            <topic>/tof/right</topic>
            <gz_frame_id>TOF_Right_link</gz_frame_id>
        </sensor>
    </gazebo>

    <!-- Left TOF Sensor -->
    <gazebo reference="TOF_Left_link">
        <sensor name="tof_left_sensor" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>1</samples>
                        <resolution>1</resolution>
                        <min_angle>0.0</min_angle>
                        <max_angle>0.0</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.01</min>
                    <max>2.0</max>
                    <resolution>0.001</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.002</stddev>
                </noise>
            </ray>
            <topic>/tof/left</topic>
            <gz_frame_id>TOF_Left_link</gz_frame_id>
        </sensor>
    </gazebo>

    <!-- ========================================================== -->
    <!-- IMU SENSOR                                                 -->
    <!-- ========================================================== -->
    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <always_on>true</always_on>
            <update_rate>50</update_rate>
            <visualize>true</visualize>
            <topic>/imu</topic>
            <gz_frame_id>imu_link</gz_frame_id>
            <imu>
                <angular_velocity>
                    <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0001</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0001</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0001</stddev></noise></z>
                </angular_velocity>
                <linear_acceleration>
                    <x><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></x>
                    <y><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></y>
                    <z><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></z>
                </linear_acceleration>
            </imu>
        </sensor>
    </gazebo>

    <gazebo>
        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
        </plugin>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
        </plugin>
    </gazebo>

</robot>